{
  "family": "ecs-bluegreen-lab-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::085876626162:role/ecs-bluegreen-lab-task-execution-role",
  "taskRoleArn": "arn:aws:iam::085876626162:role/ecs-bluegreen-lab-task-role",
  "containerDefinitions": [
    {
      "name": "ecs-bluegreen-lab-container",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_OWNER_NAME", "value": "DAVID MUHIRE" },
        { "name": "LAB_NAME", "value": "ECS Fargate Blue/Green CI/CD Lab" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecs-bluegreen-lab-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
